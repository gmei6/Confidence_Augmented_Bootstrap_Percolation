# macOS
.DS_Store

#Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
dist/

# Antigravity
.antigravity/

# C++ / CMake (covers build/, build_debug/, build_debug_native/, etc.)
build*/
*.o
*.so
*.a
.cache/

# Results — all simulation outputs are large and regenerable
# from (config, seed, commit). Keep the dir, ignore its contents.
results/raw/*
results/figures/*
results/analysis/*
results/processed/*
results/*.json
results/*.csv
!results/raw/.gitkeep
!results/figures/.gitkeep
!results/analysis/.gitkeep
!results/processed/.gitkeep
!results/poster_*_raw.json
# ...but not the superseded partial chunks; the merged *_raw.json files supersede them.
results/poster_*_part*_raw.json
results/poster_*_chunk*_raw.json

# Third-party poster templates: the .pptx is a 39 MB binary and does not belong in
# history. The (148 KB) LaTeX template PDF is tracked; re-download the pptx if needed.
okf/poster/*.pptx

# Editor — optional; keep if you want shared settings, remove if not
# .vscode/

# Local agent/tool litter
.gnhf/
overnight_*.log

# Lavish review artifacts — generated HTML review pages, not source
.lavish/

# Personal reference material — not project documentation
EXPLAINER.md